# Copie para .env ou preencha no painel do Discloud. Nunca faca commit do .env.

# Endereco do painel da hospedagem, somente o dominio.
PANEL_URL=https://painel.exemplo.com

# Chave de CLIENTE do Pterodactyl (Conta > API Credentials). Comeca com ptlc_.
PANEL_API_KEY=

# Webhook do canal do Discord.
DISCORD_WEBHOOK_URL=

# Opcional. Sem valor, o bot usa o unico servidor da conta.
# SERVER_ID=

# Opcional. Caminho do arquivo do mod, visto da raiz do servidor no SFTP.
# EVENTS_FILE=/.cache/Lua/LivingHerds-discord-events.txt

# Opcionais.
# SERVER_NAME=Living Herds
# POLL_SECONDS=20
# MAX_PER_MINUTE=6
